# Host directory mounted as /workspace in the OCDocker container.
OCDOCKER_WORKSPACE=./workspace

# Default database backend is PostgreSQL. Use install_docker.sh --db mysql to force MySQL.
OCDOCKER_DATABASE=ocdocker
OCDOCKER_OPTIMIZEDB=optimization
OCDOCKER_DB_USER=ocdocker
OCDOCKER_DB_PASS=ocdocker_pass

# Host port for the database service. Defaults: 5432 for PostgreSQL, 3306 for MySQL.
# OCDOCKER_DB_PORT=5432

# Docker image tag built by Compose.
OCDOCKER_IMAGE=ocdocker:local

# Keep Docker-mode paths inside /workspace by default.
OCDOCKER_LOCK_WORKSPACE=true

# Scheduler-managed resources. Snakemake can set these per rule.
# SNAKEMAKE_THREADS=4
# OCDOCKER_THREADS=4
# OCDOCKER_TMP_DIR=/workspace/tmp/ocdocker_job

# MySQL-only root password, used when --db mysql is selected.
MYSQL_ROOT_PASSWORD=rootpass

# Required for Docker workflows that use GNINA. Download the correct executable from:
# https://github.com/gnina/gnina
# OCDOCKER_GNINA_HOST_PATH=/absolute/path/to/gnina
