# Database
# NOTE: Default backend is PostgreSQL. Set DB_BACKEND = sqlite for a local
# SQLite backend. When enabled, a file 'ocdocker.db' is created under the
# module folder and the HOST/USER/PASSWORD settings below are ignored.
DB_BACKEND = postgresql
HOST = localhost
USER = ocdocker
PASSWORD = your_password_here
DATABASE = ocdocker
OPTIMIZEDB = optimization
PORT = 5432

# SQLite options (optional)
SQLITE_PATH = 


# Root directory for the OCDocker Database
ocdb = /data/hd4tb/OCDocker/data/ocdb

# Directory for the PCA models
pca = /data/hd4tb/OCDocker/data/pca

