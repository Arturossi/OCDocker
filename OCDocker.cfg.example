DUDEz = https://dudez.docking.org

################## VINA PARAMETERS ##################

# Maximum energy difference between the best binding mode and the worst one displayed (kcal/mol)
vina_energy_range = 10

# Exhaustiveness of the global search
vina_exhaustiveness = 5

# Maximum number of binding modes to generate
vina_num_modes = 3

# Scoring function
vina_scoring = vina

# Available scoring functions
vina_scoring_functions = vina,vinardo

################# SMINA PARAMETERS ##################

# Maximum energy difference between the best binding mode and the worst one displayed (kcal/mol)
smina_energy_range = 10

# Exhaustiveness of the global search
smina_exhaustiveness = 5

# Maximum number of binding modes to generate
smina_num_modes = 3

# Scoring function
smina_scoring = vinardo

# Available scoring functions
smina_scoring_functions = vina,vinardo,dkoes_scoring,dkoes_scoring_old,dkoes_fast,ad4_scoring

# Custom scoring file
smina_custom_scoring = no

# Custom atoms
smina_custom_atoms = no

# Local search only using autobox (you probably want to use --minimize)
smina_local_only = no

# Energy minimization
smina_minimize = no

# Generate random poses, attempting to avoid clashes
smina_randomize_only = no

# Number iterations of steepest descent; default scales with rotors and usually isn't sufficient for convergence
smina_minimize_iters = 0

# Stop minimization before convergence conditions are fully met
smina_minimize_early_term = no

# Use accurate line search
smina_accurate_line = yes

# Approximation (linear, spline, or exact) to use
smina_approximation = spline

# Approximation factor: higher results in a finer-grained approximation
smina_factor = 32

# Max allowed force; lower values more gently minimize clashing structures
smina_force_cap = 10

# Autodock map file for user grid data based calculations
smina_user_grid = no

# Scales user_grid and functional scoring
smina_user_grid_lambda = -1

################# GNINA PARAMETERS ###################

# Flexible receptor input (optional)
gnina_flex = no

# Flexible receptor residues as comma-separated list, e.g. A:ARG45,A:TYR49 (optional)
gnina_flexres = no

# Flexible receptor distance reference ligand path (optional)
gnina_flexdist_ligand = no

# Flexible receptor distance in Angstrom (optional)
gnina_flexdist = no

# Max number of flexible sidechains (optional)
gnina_flex_limit = no

# Max number of flexible residues (optional)
gnina_flex_max = no

# Autobox around ligand file (optional). Set to 'no' to disable.
# Use "auto" to autobox around the current prepared ligand (smina-like behavior).
gnina_autobox_ligand = no

# Additional padding in Angstrom for autobox (used only when autobox is enabled)
gnina_autobox_add = 4

# Extend autobox in each dimension by this amount (used only when autobox is enabled)
gnina_autobox_extend = 1

# Ignore ligand and only score receptor terms
gnina_no_lig = no

# Covalent docking receptor atom index (optional)
gnina_covalent_rec_atom = no

# Covalent docking SMARTS pattern in ligand (optional)
gnina_covalent_lig_atom_pattern = no

# Covalent docking ligand atom position index (optional)
gnina_covalent_lig_atom_position = no

# Keep covalent ligand atom position fixed
gnina_covalent_fix_lig_atom_position = no

# Covalent bond order
gnina_covalent_bond_order = 1

# Optimize ligand around covalent bond
gnina_covalent_optimize_lig = no

# Exhaustiveness of the global search
gnina_exhaustiveness = 8

# Maximum number of binding modes to generate
gnina_num_modes = 9

# Alternative scoring function
gnina_scoring = default

# Available scoring functions
gnina_scoring_functions = ad4_scoring,default,dkoes_fast,dkoes_scoring,dkoes_scoring_old,vina,vinardo

# Custom scoring file
gnina_custom_scoring = no

# Custom atoms
gnina_custom_atoms = no

# Score only, no docking
gnina_score_only = no

# Local search only using autobox (you probably want to use --minimize)
gnina_local_only = no

# Energy minimization
gnina_minimize = no

# Generate random poses, attempting to avoid clashes
gnina_randomize_only = no

# Number of monte carlo steps to take in each chain
gnina_num_mc_steps = no

# Cap on number of monte carlo steps to take in each chain
gnina_max_mc_steps = no

# Number of top poses saved in each monte carlo chain
gnina_num_mc_saved = no

# Monte Carlo temperature (optional)
gnina_temperature = no

# Number iterations of steepest descent; default scales with rotors and usually isn't sufficient for convergence
gnina_minimize_iters = 0

# Use simple gradient ascent
gnina_simple_ascent = no

# Use accurate line search
gnina_accurate_line = no

# Stop minimization before convergence conditions are fully met
gnina_minimize_early_term = no

# Minimize a single full pose
gnina_minimize_single_full = no

# Approximation (linear, spline, or exact) to use
gnina_approximation = spline

# Approximation factor: higher results in a finer-grained approximation
gnina_factor = 32

# Max allowed force; lower values more gently minimize clashing structures
gnina_force_cap = 10

# Autodock map file for user grid data based calculations
gnina_user_grid = no

# Scales user_grid and functional scoring
gnina_user_grid_lambda = -1

# Print scoring terms
gnina_print_terms = no

# Print atom types
gnina_print_atom_types = no

# CNN scoring mode: none,rescore,refinement,metrorescore,metrorefine,all
gnina_cnn_scoring = rescore

# Weight of CNN score when ranking poses
gnina_cnn = default

# Available CNN models for rescoring
