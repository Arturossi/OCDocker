digraph AutoencoderFinal {
    rankdir=LR;
    //rankdir=TB;
    splines=line;
    nodesep=0.6;
    ranksep=0.75;
    fontname="Helvetica";
    // Set the font size for the entire graph
    fontsize=10;

    // Neuron style
    node [shape=circle, fixedsize=true, width=0.35, style=filled, fontsize=10];

    // Input
    input [label="x ∈ ℝ⁴⁵⁴", shape=box, width=0.8, height=0.35, fillcolor="#4A90E2", style=filled, fontcolor=white];

    // Encoder neurons
    enc1 [label="", fillcolor="#8FBBD9"];
    enc2 [label="", fillcolor="#8FBBD9"];
    enc3 [label="", fillcolor="#8FBBD9"];

    // SELU activations with dimension label
    selu1 [label="SELU\nℝ²⁴⁰", shape=box, width=0.9, height=0.55, style=filled, fillcolor=gray95];
    selu2 [label="SELU\nℝ²⁴⁰", shape=box, width=0.9, height=0.55, style=filled, fillcolor=gray95];
    selu3 [label="SELU\nℝ²⁴⁰", shape=box, width=0.9, height=0.55, style=filled, fillcolor=gray95];

    // Latent space
    z [label="z", fillcolor="#F8E8A0"];

    // Decoder neurons
    dec1 [label="", fillcolor="#A3D9A5"];
    dec2 [label="", fillcolor="#A3D9A5"];
    dec3 [label="", fillcolor="#A3D9A5"];

    // Identity activations with dimension label
    id1 [label="Identity\nℝ²⁴⁰", shape=box, width=1.0, height=0.55, style=filled, fillcolor=gray95];
    id2 [label="Identity\nℝ²⁴⁰", shape=box, width=1.0, height=0.55, style=filled, fillcolor=gray95];
    id3 [label="Identity\nℝ²⁴⁰", shape=box, width=1.0, height=0.55, style=filled, fillcolor=gray95];

    // Output
    out [label="xʹ ∈ ℝ⁴⁵⁴", shape=box, width=0.8, height=0.35, fillcolor="#F5A623", style=filled];

    // Connections
    input -> enc1;
    input -> enc2;
    input -> enc3;

    enc1 -> selu1 -> z;
    enc2 -> selu2 -> z;
    enc3 -> selu3 -> z;

    z -> dec1;
    z -> dec2;
    z -> dec3;

    dec1 -> id1 -> out;
    dec2 -> id2 -> out;
    dec3 -> id3 -> out;
}
