[run]
branch = True
parallel = True
source =
    OCDocker
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */setup.py
    */conftest.py
    # Omit heavyweight bootstrap that is not unit-test friendly
    OCDocker/Initialise.py
    */OCDocker/Initialise.py
    # Omit Future directory (reference implementations for future work)
    # Multiple patterns to catch all variations
    OCDocker/Docking/Future/*
    OCDocker/Docking/Future/**
    Docking/Future/*
    Docking/Future/**
    **/Docking/Future/*
    **/Docking/Future/**
    # Omit archival legacy trees removed from the package (historical patterns kept for safety)
    OCDocker/**/legacy/*
    OCDocker/**/legacy/**
    **/OCDocker/**/legacy/*
    **/OCDocker/**/legacy/**
    # Omit future/reference implementation trees outside the active coverage target
    OCDocker/**/future/*
    OCDocker/**/future/**
    **/OCDocker/**/future/*
    **/OCDocker/**/future/**
    # Omit boilerplate entrypoints / empty namespace stubs
    OCDocker/Console/__main__.py
    */OCDocker/Console/__main__.py
    OCDocker/OCScore/Dimensionality/__init__.py
    */OCDocker/OCScore/Dimensionality/__init__.py
    OCDocker/Processing/Postprocessing/__init__.py
    */OCDocker/Processing/Postprocessing/__init__.py

[report]
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */setup.py
    */conftest.py
    OCDocker/Initialise.py
    */OCDocker/Initialise.py
    OCDocker/Docking/Future/*
    OCDocker/Docking/Future/**
    Docking/Future/*
    Docking/Future/**
    **/Docking/Future/*
    **/Docking/Future/**
    OCDocker/**/legacy/*
    OCDocker/**/legacy/**
    **/OCDocker/**/legacy/*
    **/OCDocker/**/legacy/**
    OCDocker/**/future/*
    OCDocker/**/future/**
    **/OCDocker/**/future/*
    **/OCDocker/**/future/**
    OCDocker/Console/__main__.py
    */OCDocker/Console/__main__.py
    OCDocker/OCScore/Dimensionality/__init__.py
    */OCDocker/OCScore/Dimensionality/__init__.py
    OCDocker/Processing/Postprocessing/__init__.py
    */OCDocker/Processing/Postprocessing/__init__.py
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
    if __name__ == .__main__.:  # noqa: E501
